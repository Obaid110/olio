    <script>
        (function() {
            "use strict";

            // ===== RESERVED SUBDOMAINS =====
            const RESERVED = new Set([
                'admin', 'info', 'support', 'contact', 'mail',
                'api', 'dashboard', 'app', 'billing', 'security',
                'login', 'www'
            ]);

            // ===== MOBILE MENU =====
            const hamburger = document.getElementById('hamburger');
            const mobileMenu = document.getElementById('mobileMenu');
            let menuOpen = false;

            hamburger.addEventListener('click', function(e) {
                e.stopPropagation();
                menuOpen = !menuOpen;
                mobileMenu.classList.toggle('open', menuOpen);
                const icon = hamburger.querySelector('i');
                icon.className = menuOpen ? 'fas fa-times' : 'fas fa-bars';
            });

            document.querySelectorAll('.mobile-menu a').forEach(link => {
                link.addEventListener('click', function() {
                    mobileMenu.classList.remove('open');
                    menuOpen = false;
                    hamburger.querySelector('i').className = 'fas fa-bars';
                });
            });

            // ===== NAVBAR SCROLL =====
            const navbar = document.getElementById('navbar');
            window.addEventListener('scroll', function() {
                navbar.classList.toggle('scrolled', window.scrollY > 20);
            });

            // ===== SMOOTH SCROLL =====
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            // ===== DOMAIN CHECK =====
            const domainInput = document.getElementById('domainInput');
            const previewDomain = document.getElementById('previewDomain');
            const statusMsg = document.getElementById('statusMsg');
            const checkBtn = document.getElementById('checkBtn');
            const finalCtaBtn = document.getElementById('finalCtaBtn');

            function sanitizeDomain(name) {
                return name.toLowerCase().replace(/[^a-z0-9-]/g, '').replace(/^-+|-+$/g, '');
            }

            function checkAvailability(name) {
                const clean = sanitizeDomain(name);
                if (!clean || clean.length < 2) {
                    return { available: false, reason: 'Name must be at least 2 characters' };
                }
                if (RESERVED.has(clean)) {
                    return { available: false, reason: 'This name is reserved and unavailable' };
                }
                // Simulate check — in production, this would be an API call
                const random = Math.random() > 0.3;
                return { available: random, reason: random ? 'Available!' : 'This name is already taken' };
            }

            function updatePreview() {
                let val = domainInput.value.trim();
                if (!val) val = 'yourname';
                previewDomain.textContent = val;
            }

            function checkDomain() {
                const raw = domainInput.value.trim();
                const clean = sanitizeDomain(raw);
                const displayName = clean || raw || 'yourname';

                if (!clean || clean.length < 2) {
                    statusMsg.innerHTML = `<span class="unavailable">⚠️ Name must be at least 2 characters</span>`;
                    return;
                }

                statusMsg.innerHTML = `<span class="checking">⏳ Checking availability...</span>`;

                setTimeout(() => {
                    const result = checkAvailability(clean);
                    if (result.available) {
                        statusMsg.innerHTML = `<span class="available">✅ ${clean}.olio.my is available!</span>`;
                        previewDomain.textContent = clean;
                    } else {
                        statusMsg.innerHTML = `<span class="unavailable">❌ ${clean}.olio.my is not available. ${result.reason}</span>`;
                        previewDomain.textContent = clean;
                    }
                }, 400);
            }

            // Event listeners
            domainInput.addEventListener('input', function() {
                updatePreview();
                const status = statusMsg.querySelector('span');
                if (status && !status.classList.contains('checking')) {
                    statusMsg.innerHTML = `<span class="checking">Enter a name to check availability</span>`;
                }
            });

            checkBtn.addEventListener('click', checkDomain);

            domainInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    checkDomain();
                }
            });

            // Example clicks
            document.querySelectorAll('.example-item').forEach(el => {
                el.addEventListener('click', function() {
                    const domain = this.dataset.domain;
                    domainInput.value = domain;
                    updatePreview();
                    checkDomain();
                });
            });

            // Final CTA
            function handleClaim() {
                const raw = domainInput.value.trim();
                const clean = sanitizeDomain(raw);
                const name = clean || 'yourname';
                if (RESERVED.has(name)) {
                    alert('⚠️ "' + name + '" is a reserved name. Please choose a different subdomain.');
                    return;
                }
                alert('🎉 Great! ' + name + '.olio.my is ready for you. Complete your registration to claim it.');
            }

            finalCtaBtn.addEventListener('click', handleClaim);

            // ===== FAQ ACCORDION =====
            document.querySelectorAll('.faq-item').forEach(item => {
                const question = item.querySelector('.faq-question');
                question.addEventListener('click', function() {
                    const isOpen = item.classList.contains('open');
                    document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('open'));
                    if (!isOpen) item.classList.add('open');
                });
            });

            // ===== INTERSECTION OBSERVER =====
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.feature-card, .step-card, .example-card, .faq-item, .hero-illustration, .email-card').forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(20px)';
                el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                observer.observe(el);
            });

            document.querySelectorAll('.hero h1, .hero p, .domain-search, .example-domains').forEach(el => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(16px)';
                el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                observer.observe(el);
            });

            // Initial preview
            updatePreview();

        })();
    </script>

